# Docker
.docker/

# CI が repository secrets から生成するデプロイ用の機密ファイル (絶対にコミットしない)
# deploy/ec2/.env は上の .env パターンでも除外されるが明示する
deploy/ec2/.env
deploy/ec2/.ghcr_token
deploy/db/.dbenv

# Misc
*.tmp
*.bak

# Iteration 2: 商品画像ローカル保存 (Iter 4 で S3 移行時に廃止)
src/Backend/Presentation/wwwroot/uploads/product-images/*
!src/Backend/Presentation/wwwroot/uploads/product-images/.gitkeep
