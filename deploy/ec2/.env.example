# ===========================================================================
# Backend 本番 .env テンプレート (EC2 / docker compose、既存 nginx-proxy 相乗り)
#
# 実運用の .env は GitHub Actions (deploy-backend.yml) が repository secrets から
# 自動生成して EC2 に配置するため、手で作る必要はない。本ファイルは「どの値が
# どの secret から来るか」のリファレンス + ローカル検証用テンプレート。
# (CLAUDE.md 原則 1: 本番は CI が生成。本ファイルはフォールバック / ドキュメント用途)
# ===========================================================================

# --- イメージ / 相乗りネットワーク ---
BACKEND_IMAGE=ghcr.io/<owner>/akebono-honshu-backend:latest
PROXY_NETWORK=tsunaguba-dev-001
# コンテナのリソース上限 (共有ホストで暴走時の同居アプリ保護)。compose が参照、未指定で既定値。
BACKEND_MEM_LIMIT=1024m
BACKEND_CPUS=1.0

# --- ASP.NET Core ランタイム ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- nginx-proxy 連携 (secret: API_VIRTUAL_HOST / LETSENCRYPT_EMAIL) ---
# これらは backend コンテナ env として注入され、nginx-proxy が docker API から読む。
VIRTUAL_HOST=akebono-honshu-api.akebono.work
VIRTUAL_PORT=8080
VIRTUAL_PROTO=http
LETSENCRYPT_HOST=akebono-honshu-api.akebono.work
LETSENCRYPT_EMAIL=ops@example.co.jp

# --- 接続文字列 (secret: PROD_DB_CONNECTION、Npgsql 形式、アプリ用 DML ユーザ) ---
ConnectionStrings__Postgres=Host=<rds-endpoint>;Port=5432;Database=akebono_honshu;Username=akebono_app;Password=<password>

# --- Firebase (secret: FIREBASE_PROJECT_ID。Frontend と同一 project) ---
Firebase__ProjectId=akebono-honshu-e388e

# --- CORS (secret: CORS_ORIGINS。Firebase Hosting 本番オリジンをカンマ区切り) ---
Cors__Origins=https://akebono-honshu-e388e.web.app

# --- 画像ストレージ (secret: IMAGE_STORAGE_PROVIDER / S3_BUCKET_NAME) ---
ImageStorage__Provider=Local
S3__BucketName=__OVERRIDE_ME__

# --- AWS (secret: AWS_REGION。Local/Environment 構成では実質未使用) ---
AWS__Region=ap-northeast-1

# --- Secrets 取得元 (本構成は repository secrets → .env のため Environment) ---
Secrets__Provider=Environment

# --- 本番ロギング (PII/SQL 値の過剰出力を抑制) ---
Logging__LogLevel__Default=Warning
Logging__LogLevel__Akebono=Information
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
