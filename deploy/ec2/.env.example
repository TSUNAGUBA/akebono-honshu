# ===========================================================================
# Backend 本番 .env テンプレート (EC2 / docker compose)
#
# 実運用の .env は GitHub Actions (deploy-backend.yml) が repository secrets から
# 自動生成して EC2 に配置するため、手で作る必要はない。本ファイルは「どの値が
# どの secret から来るか」を示すリファレンス + ローカル検証用テンプレート。
#
# CLAUDE.md 原則 1 (手動ステップを残さない): 本番は CI が生成。本ファイルは
# フォールバック / ドキュメント用途。
# ===========================================================================

# --- イメージ / 公開ポート (CI が BACKEND_IMAGE を上書き) ---
BACKEND_IMAGE=ghcr.io/<owner>/akebono-honshu-backend:latest
BACKEND_HOST_PORT=8080

# --- ASP.NET Core ランタイム ---
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# --- 接続文字列 (secret: PROD_DB_CONNECTION、Npgsql 形式) ---
ConnectionStrings__Postgres=Host=<rds-endpoint>;Port=5432;Database=akebono_honshu;Username=<app-user>;Password=<password>

# --- Firebase (secret: FIREBASE_PROJECT_ID。dev/prod で必ず別 project) ---
Firebase__ProjectId=akebono-honshu-prod

# --- CORS (secret: CORS_ORIGINS。Firebase Hosting 本番オリジンをカンマ区切り) ---
Cors__Origins=https://akebono-honshu-prod.web.app

# --- 画像ストレージ (secret: IMAGE_STORAGE_PROVIDER / S3_BUCKET_NAME) ---
# Local = コンテナ内 wwwroot/uploads (compose の named volume で永続化)
# S3    = AWS S3 + Pre-signed URL (EC2 インスタンスプロファイルに S3 権限が必要)
ImageStorage__Provider=Local
S3__BucketName=__OVERRIDE_ME__

# --- AWS (secret: AWS_REGION) ---
AWS__Region=ap-northeast-1

# --- Secrets 取得元 (本構成は repository secrets → .env のため Environment) ---
# AWS Secrets Manager 運用に切替える場合は AwsSecretsManager + Secrets__AwsPrefix を設定し、
# EC2 インスタンスプロファイルに Secrets Manager / KMS 権限を付与する (migration-plan §4.2.2)。
Secrets__Provider=Environment

# --- 本番ロギング (migration-plan §4.2.3 P2-2: PII/SQL 値の過剰出力を抑制) ---
Logging__LogLevel__Default=Warning
Logging__LogLevel__Akebono=Information
Logging__LogLevel__Microsoft.Hosting.Lifetime=Information
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
